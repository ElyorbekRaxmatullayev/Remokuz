# ==========================================================================
# Remok.uz — переменные окружения
#
# ⚠️ ЭТОТ ФАЙЛ НЕ РАБОТАЕТ САМ ПО СЕБЕ.
#
# Браузер не умеет читать .env — это не ограничение, которое можно обойти,
# так устроен любой сайт. Всё, что попадает в браузер, посетитель может
# открыть и прочитать: и js/config.js, и .env, если положить его рядом.
#
# .env имеет смысл только там, где есть сервер, который его читает.
# У нас это Cloudflare Worker (файл worker.js в корне проекта).
#
# Порядок такой:
#   1. Скопируйте этот файл в .env  и впишите свои значения
#   2. Разверните worker.js по инструкции внутри него
#   3. Перенесите эти значения в Cloudflare:
#      Worker → Settings → Variables and Secrets → тип Secret
#   4. В js/config.js укажите ENDPOINT и очистите TG_TOKEN
#
# Сам .env на хостинг сайта заливать НЕ НУЖНО — он нужен только вам,
# как памятка. Он уже добавлен в .gitignore.
# ==========================================================================

# Токен бота от @BotFather
TG_TOKEN=8447297138:AAHvQ1AuSqHuaG8Ph7WiGuXJLR77zpMXJb4

# Кому приходят заявки — числовые ID через запятую, без пробелов.
# Каждый получатель должен сам нажать «Начать» у бота https://t.me/remokuz_bot,
# иначе Telegram ответит «chat not found» и заявка не дойдёт.
TG_CHAT_IDS=2077634702,1430286964,5884034743

# С какого сайта принимать заявки. Защищает от того, чтобы вашим
# обработчиком пользовались чужие. Укажите '*' только для отладки.
ALLOW_ORIGIN=https://remok.uz
